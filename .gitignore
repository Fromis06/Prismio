# ==========================================
# 1. Executables & Compiled Binaries
# ==========================================
# Binaries for programs and plugins
*.exe
*.exe-
*.dll
*.so
*.dylib

# Test binaries generated by `go test -c`
*.test

# Output binary build directory (nếu bạn hay build vào thư mục bin/ hoặc dist/)
/bin/
/dist/

# ==========================================
# 2. Test & Coverage Reports
# ==========================================
*.out
*.cover
*.prof
coverage.txt

# ==========================================
# 3. Environment & Local Configurations
# ==========================================
# Bỏ qua các file chứa bí mật/biến môi trường cá nhân
.env
.env.*
!.env.example

# ==========================================
# 4. IDE & Text Editor Files
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / GoLand
.idea/

# Vim / Sublime
*.swp
*~

# ==========================================
# 5. OS Generated Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.txt
.md
/vendor/
.yaml